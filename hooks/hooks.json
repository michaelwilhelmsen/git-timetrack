{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/hook-handler.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
